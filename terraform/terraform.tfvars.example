# Copy to terraform.tfvars and edit. terraform.tfvars is gitignored.
#
# Every value below has a working default — an empty terraform.tfvars applies
# cleanly. These are here to be changed, not to be required.

# region           = "us-east-1"
# instance_type    = "t3.xlarge"   # 16 GB. See variables.tf for why not t3.large.
# root_volume_size = 40

# Path to an SSH public key you already have.
# public_key_path = "~/.ssh/id_ed25519.pub"

# Leave unset to auto-detect this machine's public IP as a /32.
# Set it explicitly if you are behind a fixed egress address.
# allowed_ssh_cidr = "203.0.113.42/32"
